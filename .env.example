# ============================================================
# Personal Finance Intelligence System - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Application
APP_ENV=development
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/finance_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Secrets - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret_here
JWT_REFRESH_SECRET=CHANGE_ME_generate_another_random_secret_here

# AI Provider: "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI (required if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...your-key-here...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (required if AI_PROVIDER=gemini)
GEMINI_API_KEY=...your-key-here...
GEMINI_MODEL=gemini-1.5-flash

# Categorization confidence thresholds (0.0 to 1.0)
AUTO_CATEGORIZE_THRESHOLD=0.90
SUGGEST_CATEGORY_THRESHOLD=0.70

# File uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/tmp/finance_imports

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:4200"]

# Celery background workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Defaults
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
